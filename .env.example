# Sendblue (iMessage). Leave blank to use the local simulator.
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
# Nod's own Sendblue line, E.164 (e.g. +15550100000)
SENDBLUE_FROM_NUMBER=
# Shared secret for the inbound webhook. Register the webhook URL with Sendblue as
# https://<your-app>/api/inbound?token=<SENDBLUE_WEBHOOK_SECRET>
SENDBLUE_WEBHOOK_SECRET=

# Supabase Postgres connection string (transaction pooler is fine)
DATABASE_URL=

# Claude, for the "is this addressed to Nod?" check on ambiguous messages
ANTHROPIC_API_KEY=
# Optional: model for that check (default claude-opus-5-5 at low effort)
NOD_CLASSIFIER_MODEL=

# Public URL of the web app (used for Nod's hosted contact card)
NOD_APP_URL=
# Onboarding media (default to files under NOD_APP_URL). The how-to video is the
# five-second recording of adding Nod to a group; the logo is the contact photo.
NOD_HOWTO_VIDEO_URL=
NOD_LOGO_URL=
# Model and effort for Nod's replies (defaults: claude-opus-5-5, medium)
NOD_MODEL=
NOD_EFFORT=
# Optional: model for web searches (defaults to NOD_MODEL, then claude-opus-5-5)
NOD_SEARCH_MODEL=
# Model for reading receipt photos (default NOD_MODEL, then claude-opus-5-5).
NOD_RECEIPT_MODEL=
# Inngest (vote nudges and deadlines), served at /api/inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Default timezone for group deadlines ("Friday 6pm"), until a group sets its own
NOD_TIMEZONE=America/New_York

# Stripe Connect (payments, step 10). Payments are off until STRIPE_SECRET_KEY is set.
# Use test-mode keys (sk_test_…, pk_test_…) until launch.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the Connect webhook endpoint pointed at {NOD_APP_URL}/api/stripe
# (events: payment_intent.*, account.updated; "events on connected accounts").
STRIPE_WEBHOOK_SECRET=
