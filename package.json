{
  "name": "nod",
  "version": "1.0.0",
  "description": "Nod group-chat agent",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sim": "tsx src/messaging/simulator/cli.ts",
    "sim:web": "node scripts/build-sim-web.mjs",
    "invites": "tsx scripts/invites.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node scripts/db-check.mjs",
    "check": "tsx scripts/check.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sendblue:webhook": "tsx scripts/sendblue-webhook.ts",
    "vercel-build": "node scripts/migrate-on-deploy.mjs && next build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjm0609hc-code/Node.ai.git"
  },
  "bugs": {
    "url": "https://github.com/wjm0609hc-code/Node.ai/issues"
  },
  "homepage": "https://github.com/wjm0609hc-code/Node.ai#readme",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "drizzle-orm": "^0.45.3",
    "inngest": "^4.21.0",
    "next": "^16.3.7",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "undici": "^8.11.2"
  }
}
